# Вставьте ключ OpenAI после знака =. Этот файл не попадает во фронтенд.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Необязательно: второй независимый рецензент Task Pack через NVIDIA NIM.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Сгенерируйте случайную строку и задайте её для первого назначения администратора.
ADMIN_BOOTSTRAP_TOKEN=
# Для другой модели укажите её тарифы за 1 млн токенов; иначе стоимость будет «неизвестна».
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
DATABASE_PATH=.data/forge-live.db
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
